# Токен от @BotFather
TELEGRAM_BOT_TOKEN=
# Твой Telegram user id (узнать у @userinfobot). Бот отвечает ТОЛЬКО этому id.
TELEGRAM_ALLOWED_USER_ID=
# Необязательно: если не задан, Agent SDK использует твой логин в Claude Code
# ANTHROPIC_API_KEY=
# Модель агента (необязательно)
# AGENT_MODEL=claude-sonnet-5-5
# Напоминание о неустановленном: день недели (0=вс, 1=пн … 6=сб) и час (локальное время)
REMINDER_WEEKDAY=1
REMINDER_HOUR=10
# Ежедневный тычок про один забытый запас (час, локальное время)
NUDGE_HOUR=19
